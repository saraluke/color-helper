<body>
<style>
:root{
  --ground:#F1F3F6; --surface:#FFFFFF; --surface-2:#E9ECF1;
  --ink:#15181D; --muted:#5F656E; --faint:#8B919B;
  --rule:#DBDFE6; --rule-strong:#C3C9D3;
  --accent:#223886; --accent-soft:#E4E8F4;
  --shadow:0 1px 2px rgba(21,24,29,.06),0 6px 18px -10px rgba(21,24,29,.18);
}
@media (prefers-color-scheme:dark){
  :root:not([data-theme="light"]){
    --ground:#0F1114; --surface:#181B21; --surface-2:#20242B;
    --ink:#ECEEF2; --muted:#949BA5; --faint:#6E757F;
    --rule:#262A32; --rule-strong:#39404A;
    --accent:#95AEEA; --accent-soft:#1D2534;
    --shadow:0 1px 2px rgba(0,0,0,.4),0 6px 18px -10px rgba(0,0,0,.6);
  }
}
:root[data-theme="dark"]{
  --ground:#0F1114; --surface:#181B21; --surface-2:#20242B;
  --ink:#ECEEF2; --muted:#949BA5; --faint:#6E757F;
  --rule:#262A32; --rule-strong:#39404A;
  --accent:#95AEEA; --accent-soft:#1D2534;
  --shadow:0 1px 2px rgba(0,0,0,.4),0 6px 18px -10px rgba(0,0,0,.6);
}

*{box-sizing:border-box}
body{
  margin:0; background:var(--ground); color:var(--ink);
  font-family:"Archivo","Helvetica Neue",Arial,sans-serif;
  font-size:15px; line-height:1.5;
  -webkit-font-smoothing:antialiased;
}
.wrap{max-width:1180px;margin:0 auto;padding:0 24px 96px}

/* ---------- masthead ---------- */
header.mast{padding:56px 0 28px;border-bottom:1px solid var(--rule)}
.eyebrow{
  font-size:11px;font-weight:600;letter-spacing:.16em;text-transform:uppercase;
  color:var(--muted);margin:0 0 14px;
}
h1{
  font-family:"Instrument Serif",Georgia,serif; font-weight:400;
  font-size:clamp(40px,7vw,68px); line-height:1.02; letter-spacing:-.015em;
  margin:0; text-wrap:balance;
}
h1 em{font-style:italic;color:var(--muted)}
.lede{
  margin:18px 0 0; max-width:60ch; color:var(--muted); font-size:16px;
}
.meta{
  display:flex;flex-wrap:wrap;gap:8px 28px;margin-top:24px;
  font-family:"IBM Plex Mono",ui-monospace,monospace;font-size:12px;color:var(--faint);
}
.meta b{color:var(--ink);font-weight:500}

.notice{
  margin-top:26px;padding:16px 18px;border-radius:9px;
  background:var(--surface-2);border:1px solid var(--rule);
  display:flex;flex-direction:column;gap:9px;max-width:74ch;
}
.notice p{margin:0;font-size:13px;line-height:1.55;color:var(--muted)}

/* ---------- controls ---------- */
.bar{
  position:sticky;top:0;z-index:20;background:var(--ground);
  border-bottom:1px solid var(--rule);
  display:flex;flex-wrap:wrap;align-items:center;gap:12px;
  padding:12px 0; margin-bottom:8px;
}
.search{position:relative;flex:1 1 240px;min-width:200px}
.search input{
  width:100%;padding:9px 12px 9px 34px;border-radius:7px;
  border:1px solid var(--rule-strong);background:var(--surface);color:var(--ink);
  font:inherit;font-size:14px;
}
.search input::placeholder{color:var(--faint)}
.search input:focus{outline:2px solid var(--accent);outline-offset:1px;border-color:transparent}
.search svg{position:absolute;left:11px;top:50%;transform:translateY(-50%);color:var(--faint)}
.seg{display:flex;border:1px solid var(--rule-strong);border-radius:7px;overflow:hidden;background:var(--surface)}
.seg button{
  appearance:none;border:0;background:transparent;color:var(--muted);
  font:inherit;font-size:12px;font-weight:600;letter-spacing:.04em;
  padding:8px 14px;cursor:pointer;
}
.seg button + button{border-left:1px solid var(--rule)}
.seg button[aria-pressed="true"]{background:var(--accent-soft);color:var(--accent)}
.seg button:focus-visible{outline:2px solid var(--accent);outline-offset:-2px}
.count{font-family:"IBM Plex Mono",monospace;font-size:12px;color:var(--faint);white-space:nowrap}

/* ---------- sections ---------- */
section.fam{padding-top:42px}
.fam-head{display:flex;align-items:baseline;gap:12px;margin-bottom:16px;
  border-bottom:1px solid var(--rule);padding-bottom:8px}
.fam-head h2{
  font-family:"Archivo",sans-serif;font-size:12px;font-weight:700;
  letter-spacing:.14em;text-transform:uppercase;margin:0;
}
.fam-head .n{font-family:"IBM Plex Mono",monospace;font-size:11px;color:var(--faint)}
.fam-head .note{
  margin-left:auto;font-size:11px;color:var(--muted);font-style:italic;
  font-family:"Instrument Serif",Georgia,serif;font-size:15px;
}

.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(158px,1fr));gap:14px}
.chip{
  background:var(--surface);border:1px solid var(--rule);border-radius:9px;
  overflow:hidden;text-align:left;padding:0;font:inherit;color:inherit;
  cursor:pointer;display:flex;flex-direction:column;
  transition:box-shadow .16s ease, transform .16s ease, border-color .16s ease;
}
@media (prefers-reduced-motion:reduce){.chip{transition:none}}
.chip:hover{box-shadow:var(--shadow);border-color:var(--rule-strong);transform:translateY(-1px)}
.chip:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.swatch{height:82px;position:relative;border-bottom:1px solid var(--rule)}
.swatch.pale::after{content:"";position:absolute;inset:0;box-shadow:inset 0 0 0 1px rgba(21,24,29,.13)}
.chip .body{padding:9px 11px 11px;display:flex;flex-direction:column;gap:3px}
.chip .name{font-size:13.5px;font-weight:600;line-height:1.25;letter-spacing:-.005em}
.chip .val{
  font-family:"IBM Plex Mono",monospace;font-size:11px;color:var(--muted);
  font-variant-numeric:tabular-nums;
}
.chip .idx{
  font-family:"IBM Plex Mono",monospace;font-size:10px;color:var(--faint);
  position:absolute;top:6px;right:8px;
  background:rgba(255,255,255,.82);color:#15181D;
  padding:1px 5px;border-radius:4px;opacity:0;transition:opacity .15s;
}
.chip:hover .idx,.chip:focus-visible .idx{opacity:1}

/* list view */
body[data-view="list"] .grid{display:block}
body[data-view="list"] .chip{
  flex-direction:row;align-items:center;gap:14px;border-radius:0;
  border:0;border-bottom:1px solid var(--rule);background:transparent;padding:7px 4px;
}
body[data-view="list"] .chip:hover{transform:none;box-shadow:none;background:var(--surface)}
body[data-view="list"] .swatch{
  height:30px;width:52px;flex:none;border:1px solid var(--rule);border-radius:5px;
}
body[data-view="list"] .chip .body{flex-direction:row;align-items:baseline;gap:16px;padding:0;flex:1;min-width:0}
body[data-view="list"] .chip .name{flex:0 0 200px}
body[data-view="list"] .chip .idx{display:none}

.empty{padding:60px 0;text-align:center;color:var(--muted);
  font-family:"Instrument Serif",Georgia,serif;font-size:22px}

/* toast */
#toast{
  position:fixed;left:50%;bottom:26px;transform:translate(-50%,14px);
  background:var(--ink);color:var(--ground);padding:9px 16px;border-radius:999px;
  font-size:13px;font-weight:500;opacity:0;pointer-events:none;
  transition:opacity .18s ease,transform .18s ease;z-index:50;
  font-family:"IBM Plex Mono",monospace;
}
#toast.on{opacity:1;transform:translate(-50%,0)}

footer.foot{
  margin-top:64px;padding-top:20px;border-top:1px solid var(--rule);
  color:var(--faint);font-size:12.5px;max-width:70ch;
}
footer.foot p{margin:0 0 8px}
footer.foot code{font-family:"IBM Plex Mono",monospace;color:var(--muted)}

@media print{
  .bar,#toast{display:none}
  body{background:#fff;color:#000}
  .chip{break-inside:avoid;border-color:#ccc}
  .grid{grid-template-columns:repeat(6,1fr)}
}
@media (max-width:560px){
  .wrap{padding:0 16px 72px}
  header.mast{padding-top:36px}
  .grid{grid-template-columns:repeat(auto-fill,minmax(132px,1fr));gap:10px}
  body[data-view="list"] .chip .name{flex:0 0 auto}
  body[data-view="list"] .chip .body{flex-wrap:wrap;gap:4px 12px}
}
</style>


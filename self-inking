  var toast=document.getElementById('toast'), tId;
  function say(msg){
    toast.textContent=msg; toast.classList.add('on');
    clearTimeout(tId); tId=setTimeout(function(){toast.classList.remove('on');},1500);
  }
  function copy(c){
    var text=val(c);
    var done=function(){say('Copied  '+text);};
    try{
      if(navigator.clipboard && navigator.clipboard.writeText){
        navigator.clipboard.writeText(text).then(done,function(){legacy(text,done);});
      } else { legacy(text,done); }
    }catch(e){ legacy(text,done); }
  }
  function legacy(text,done){
    try{
      var ta=document.createElement('textarea');
      ta.value=text; ta.setAttribute('readonly',''); ta.style.position='fixed'; ta.style.opacity='0';
      document.body.appendChild(ta); ta.select(); document.execCommand('copy');
      document.body.removeChild(ta); done();
    }catch(e){ say(text); }
  }

  function refmt(){
    FAMS.forEach(function(f){
      f.colors.forEach(function(c){
        var el=out.querySelector('.chip[data-hex="'+c.h+'"][data-name="'+c.n.toLowerCase()+'"] .val');
        if(el) el.textContent=val(c);
      });
    });
  }

  function filter(){
    var q=document.getElementById('q').value.trim().toLowerCase();
    var total=0;
    out.querySelectorAll('section.fam').forEach(function(sec){
      var shown=0;
      sec.querySelectorAll('.chip').forEach(function(ch){
        var hit = !q || ch.dataset.name.indexOf(q)>-1 || ch.dataset.hex.toLowerCase().indexOf(q)>-1;
        ch.hidden=!hit; if(hit) shown++;
      });
      sec.hidden = shown===0 && !!q;
      total+=shown;
    });
    countEl.textContent = total + (total===1?' shown':' shown');
  }

  document.querySelectorAll('.seg button[data-fmt]').forEach(function(btn){
    btn.addEventListener('click',function(){
      fmt=btn.dataset.fmt;
      document.querySelectorAll('.seg button[data-fmt]').forEach(function(b){
        b.setAttribute('aria-pressed', String(b===btn));
      });
      refmt();
    });
  });
  document.querySelectorAll('.seg button[data-view]').forEach(function(btn){
    btn.addEventListener('click',function(){
      document.body.dataset.view=btn.dataset.view;
      document.querySelectorAll('.seg button[data-view]').forEach(function(b){
        b.setAttribute('aria-pressed', String(b===btn));
      });
    });
  });
  document.getElementById('q').addEventListener('input',filter);

  document.body.dataset.view='grid';
  build();
  filter();
})();
</script>

</body>
</html>
